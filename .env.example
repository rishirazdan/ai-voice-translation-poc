# Server
APP_HOST=127.0.0.1
APP_PORT=8010
PUBLIC_BASE_URL=https://example.ngrok-free.app
LOG_LEVEL=INFO

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REQUIRE_TWILIO_SIGNATURE=false
TWILIO_HANDOFF_FROM_NUMBER=+1xxxxxxxxxx
DEFAULT_HUMAN_AGENT_NUMBER=+1xxxxxxxxxx
REQUIRE_ACTIVE_CALL_SID_FOR_HANDOFF=true
ENABLE_CUSTOMER_RECONNECT=false
CUSTOMER_RECONNECT_ANNOUNCEMENT=Please stay available. We are reconnecting your call to a human agent now. You may receive a callback in a few seconds.
HANDOFF_DRY_RUN=true
LATENCY_SAMPLE_SIZE=500
ESTIMATED_TTS_MS_PER_TURN=650

# ElevenLabs handoff webhook auth
REQUIRE_ELEVENLABS_HANDOFF_SECRET=true
ELEVENLABS_HANDOFF_SECRET=replace-with-strong-shared-secret

# ConversationRelay
CONVERSATION_RELAY_WS_PATH=/ws/conversationrelay
DEFAULT_CALLER_LANGUAGE=auto
DEFAULT_AGENT_LANGUAGE=en-US
TTS_PROVIDER=ElevenLabs

# Translation provider: mock|openai
TRANSLATION_PROVIDER=mock

# OpenAI (if TRANSLATION_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
